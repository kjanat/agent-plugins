#!/bin/sh
set -eu
export VOLTA_BYPASS=1

root=$(CDPATH='' cd -- "$(dirname -- "${0}")/.." && pwd)
modules="${root}/node_modules"

case $(uname -s) in
  Linux) os=linux ;;
  Darwin) os=darwin ;;
  *) os= ;;
esac
case $(uname -m) in
  x86_64 | amd64) arch=x64 ;;
  aarch64 | arm64) arch=arm64 ;;
  *) arch= ;;
esac

native="${modules}/@typescript/typescript-${os}-${arch}/lib/tsc"
if [ -n "${os}" ] && [ -n "${arch}" ] && [ -x "${native}" ]; then
  exec "${native}" --lsp --stdio "$@"
fi

exec node "${modules}/typescript/bin/tsc" --lsp --stdio "$@"

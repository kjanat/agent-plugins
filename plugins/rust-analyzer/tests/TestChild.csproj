<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseAppHost>true</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>AgentPlugins.RustAnalyzer</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep managed runtime overhead bounded; the allocation probe uses unmanaged memory. -->
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="33554432" />
  </ItemGroup>
</Project>

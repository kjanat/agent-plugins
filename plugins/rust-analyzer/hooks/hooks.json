{
	"hooks": {
		"Setup": [
			{
				"matcher": "init",
				"hooks": [
					{
						"type": "command",
						"command": "cargo",
						"args": [
							"install",
							"--git",
							"https://github.com/kjanat/agent-plugins.git",
							"--branch",
							"master",
							"rust-analyzer-guard",
							"--root",
							"${CLAUDE_PLUGIN_DATA}/runtime/0.3.0",
							"--target-dir",
							"${CLAUDE_PLUGIN_DATA}/build/0.3.0",
							"--locked",
							"--force",
							"--bin",
							"rust-analyzer-guard",
							"--quiet"
						],
						"timeout": 120
					}
				]
			}
		]
	}
}
